<Window x:Class="WpfApp2.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="390" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="White" Margin="16" Padding="18" CornerRadius="9" BorderBrush="#DDE5EF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Change your password" FontSize="20" FontWeight="Bold" Foreground="#145DA0"/>
            <TextBlock x:Name="TextNotice" Margin="0,5,0,17" TextWrapping="Wrap" Foreground="#526276"/>
            <TextBlock Text="Current password"/>
            <PasswordBox x:Name="OldPassword" Margin="0,4,0,11"/>
            <TextBlock Text="New password"/>
            <PasswordBox x:Name="NewPassword" Margin="0,4,0,11"/>
            <TextBlock Text="Confirm new password"/>
            <PasswordBox x:Name="ConfirmPassword" Margin="0,4,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="90" Click="Cancel_Click" Margin="0,0,7,0"/>
                <Button Content="Save Password" Width="135" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

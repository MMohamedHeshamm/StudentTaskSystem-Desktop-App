<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Task Manager — Teacher Dashboard" Height="660" Width="1100"
        MinHeight="560" MinWidth="970" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Students Dashboard" FontSize="23" FontWeight="Bold" Foreground="#145DA0" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Change Password" Click="ChangePassword_Click" Margin="0,0,8,0"/>
                <Button Content="Log out" Click="LogOut_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,14,0" BorderBrush="#DDE5EF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Student details" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="Full name"/>
                        <TextBox x:Name="TextBoxOfName" Margin="0,4,0,12"/>
                        <TextBlock Text="Age (1–120)"/>
                        <TextBox x:Name="TextBoxOfAge" Margin="0,4,0,12"/>
                        <TextBlock Text="Username"/>
                        <TextBox x:Name="TextBoxUser" Margin="0,4,0,12"/>
                        <TextBlock Text="Password"/>
                        <PasswordBox x:Name="PasswordBoxPass" Margin="0,4,0,4"/>
                        <TextBlock Text="Leave blank during edit to keep the current password."
                                   FontSize="11" Foreground="#526276" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,3,0,10">
                            <Button Content="Add" Width="70" Click="Add_Button_Click" Margin="0,0,6,6"/>
                            <Button Content="Update" Width="70" Click="Update_Button_Click" Margin="0,0,6,6"/>
                            <Button Content="Delete" Width="70" Click="Delete_Button_Click" Margin="0,0,6,6"/>
                            <Button Content="Clear" Width="70" Click="Clear_Button_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Separator Margin="0,4,0,15"/>
                        <Button Content="Selected Student's Assignments" Click="ShowAssignments_Click" Margin="0,0,0,8"/>
                        <Button Content="All Assignments" Click="ShowAllAssignments_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Padding="10" Background="White" CornerRadius="8" BorderBrush="#DDE5EF" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="Select a student to edit or manage assignments" FontSize="13" Margin="4,4,0,12"
                               Foreground="#526276" DockPanel.Dock="Top"/>
                    <DataGrid x:Name="DgStudent" AutoGenerateColumns="False" SelectionMode="Single"
                              SelectionChanged="DgStudent_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="55"/>
                            <DataGridTextColumn Header="Full name" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Age" Binding="{Binding StudentAge}" Width="70"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding User.Username}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

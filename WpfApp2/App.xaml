<Application x:Class="WpfApp2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Windows/AuthWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#145DA0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#526276"/>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#F5F8FC"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#26384D"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#E4EDF7"/>
            <Setter Property="BorderBrush" Value="#CAD6E5"/>
            <Setter Property="Foreground" Value="#17304F"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AlternatingRowBackground" Value="#F2F6FC"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
    </Application.Resources>
</Application>
